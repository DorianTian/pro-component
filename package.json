{
  "name": "pro-components",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@8.15.9",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "build": "turbo build",
    "build:dts": "turbo build:dts",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "turbo type-check",
    "build:cdn": "turbo build:cdn",
    "clean": "turbo clean",
    "dev:playground": "pnpm --filter playground dev",
    "validate-build": "tsx scripts/validate-build.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "docs:dev": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build",
    "docs:preview": "pnpm --filter docs preview",
    "gen:api": "pnpm --filter docs gen:api",
    "gen:changelog": "pnpm --filter docs gen:changelog",
    "release:ci": "tsx scripts/ci/check-npm-version.ts && changeset publish",
    "compat:quick": "COMPAT_MODE=quick tsx scripts/ci/compat-matrix.ts",
    "compat:full": "COMPAT_MODE=full tsx scripts/ci/compat-matrix.ts",
    "cdn:sync": "tsx scripts/ci/cdn-sync.ts",
    "cdn:health": "tsx scripts/ci/cdn-health-check.ts",
    "license:check": "tsx scripts/ci/license-check.ts",
    "rotation:check": "tsx scripts/ci/token-rotation-check.ts"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "@element-plus/icons-vue": "^2.3.0",
    "@eslint/js": "^9.0.0",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^0.4.0",
    "@rollup/plugin-typescript": "^12.0.0",
    "@tiptap/extension-character-count": "^3.22.1",
    "@tiptap/extension-code-block-lowlight": "^3.22.1",
    "@tiptap/extension-color": "^3.22.1",
    "@tiptap/extension-highlight": "^3.22.1",
    "@tiptap/extension-image": "^3.22.1",
    "@tiptap/extension-link": "^3.22.1",
    "@tiptap/extension-placeholder": "^3.22.1",
    "@tiptap/extension-table": "^3.22.1",
    "@tiptap/extension-table-cell": "^3.22.1",
    "@tiptap/extension-table-header": "^3.22.1",
    "@tiptap/extension-table-row": "^3.22.1",
    "@tiptap/extension-task-item": "^3.22.1",
    "@tiptap/extension-task-list": "^3.22.1",
    "@tiptap/extension-text-align": "^3.22.1",
    "@tiptap/extension-text-style": "^3.22.1",
    "@tiptap/extension-underline": "^3.22.1",
    "@tiptap/pm": "^3.22.1",
    "@tiptap/starter-kit": "^3.22.1",
    "@tiptap/vue-3": "^3.22.1",
    "@types/node": "^25.5.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/compiler-sfc": "^3.5.0",
    "acorn": "^8.12.0",
    "esbuild": "^0.27.4",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "monaco-editor": "^0.55.1",
    "monaco-themes": "^0.4.8",
    "postcss": "^8.4.0",
    "prettier": "^3.0.0",
    "rollup": "^4.0.0",
    "rollup-plugin-dts": "^6.0.0",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-postcss": "^4.0.0",
    "rollup-plugin-vue": "^6.0.0",
    "tslib": "^2.6.0",
    "tsx": "^4.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vue-component-meta": "^3.2.6",
    "vue-tsc": "^2.0.0"
  }
}
