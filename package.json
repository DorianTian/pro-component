  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@8.15.9",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "build": "turbo build",
