{
  "name": "@pro/cdn-build",
  "version": "0.0.1",
  "private": true,
  "description": "CDN build scripts — generate ESM/UMD bundles with SRI hashes",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "echo '@pro/cdn-build: use build:cdn to generate CDN bundles'",
    "build:cdn": "tsx src/index.ts",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "rollup": "^4.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-terser": "^0.4.0",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-vue": "^6.0.0",
    "rollup-plugin-postcss": "^4.0.0",
    "glob": "^11.0.0"
  },
  "devDependencies": {
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
