{
  "name": "@pro/pro-components",
  "version": "0.0.1",
  "description": "All Pro Components in one package",
  "type": "module",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.mjs",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./style": "./dist/style/index.css"
  },
  "sideEffects": [
    "dist/style/**"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsx ../../scripts/build-package.ts .",
    "build:dts": "tsx ../../scripts/gen-aggregation-dts.ts .",
    "type-check": "vue-tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@pro/table": "workspace:*",
    "@pro/form": "workspace:*",
    "@pro/descriptions": "workspace:*",
    "@pro/hooks": "workspace:*",
    "@pro/locale": "workspace:*",
    "@pro/utils": "workspace:*",
    "@pro/themes": "workspace:*",
    "@pro/tree": "workspace:*",
    "@pro/tabs": "workspace:*",
    "@pro/tag": "workspace:*",
    "@pro/empty": "workspace:*",
    "@pro/result": "workspace:*",
    "@pro/loading": "workspace:*",
    "@pro/input": "workspace:*",
    "@pro/input-number": "workspace:*",
    "@pro/select": "workspace:*",
    "@pro/cascader": "workspace:*",
    "@pro/tree-select": "workspace:*",
    "@pro/date-picker": "workspace:*",
    "@pro/time-picker": "workspace:*",
    "@pro/switch": "workspace:*",
    "@pro/radio": "workspace:*",
    "@pro/checkbox": "workspace:*",
    "@pro/rate": "workspace:*",
    "@pro/slider": "workspace:*",
    "@pro/upload": "workspace:*",
    "@pro/color-picker": "workspace:*",
    "@pro/auto-complete": "workspace:*",
    "@pro/dialog": "workspace:*",
    "@pro/drawer": "workspace:*",
    "@pro/popover": "workspace:*",
    "@pro/tooltip": "workspace:*",
    "@pro/popconfirm": "workspace:*",
    "@pro/badge": "workspace:*",
    "@pro/statistic": "workspace:*",
    "@pro/pagination": "workspace:*",
    "@pro/breadcrumb": "workspace:*",
    "@pro/steps": "workspace:*",
    "@pro/divider": "workspace:*",
    "dayjs": "^1.11.0"
  },
  "peerDependencies": {
    "vue": ">=3.4.0",
    "element-plus": ">=2.9.0",
    "vue-i18n": "^9.9.0 || ^10.0.0 || ^11.0.0"
  },
  "peerDependenciesMeta": {
    "vue-i18n": {
      "optional": true
    }
  }
}
