{
  "name": "@pro/pro-components",
  "version": "0.0.1",
  "description": "All Pro Components in one package",
  "type": "module",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.mjs",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./style": "./dist/style/index.css"
  },
  "sideEffects": [
    "dist/style/**"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsx ../../scripts/build-package.ts .",
    "build:dts": "tsx ../../scripts/gen-aggregation-dts.ts .",
    "type-check": "vue-tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@pro/table": "workspace:*",
    "@pro/form": "workspace:*",
    "@pro/descriptions": "workspace:*",
    "@pro/hooks": "workspace:*",
    "@pro/utils": "workspace:*",
    "@pro/themes": "workspace:*"
  },
  "peerDependencies": {
    "vue": ">=3.4.0",
    "element-plus": ">=2.9.0",
    "vue-i18n": "^9.9.0 || ^10.0.0 || ^11.0.0"
  },
  "peerDependenciesMeta": {
    "vue-i18n": {
      "optional": true
    }
  }
}
