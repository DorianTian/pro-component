{
  "name": "@pro/editor",
  "version": "0.0.1",
  "description": "TipTap-based rich text editor with enterprise toolbar, tables, images, and collaboration-ready architecture",
  "type": "module",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.mjs",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./style": "./dist/style/index.css"
  },
  "sideEffects": [
    "dist/style/**"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsx ../../scripts/build-package.ts .",
    "build:dts": "vue-tsc --declaration --emitDeclarationOnly --outDir dist/types",
    "type-check": "vue-tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "vue": ">=3.4.0",
    "@tiptap/vue-3": ">=3.0.0",
    "@tiptap/starter-kit": ">=3.0.0"
  }
}
