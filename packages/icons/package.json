{
  "name": "@pro/icons",
  "version": "0.0.1",
  "description": "Enterprise icon library — categorized re-exports of Lucide icons for Pro Components",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./navigation": "./src/categories/navigation.ts",
    "./action": "./src/categories/action.ts",
    "./status": "./src/categories/status.ts",
    "./data": "./src/categories/data.ts",
    "./user": "./src/categories/user.ts",
    "./file": "./src/categories/file.ts",
    "./communication": "./src/categories/communication.ts",
    "./commerce": "./src/categories/commerce.ts",
    "./editor": "./src/categories/editor.ts"
  },
  "sideEffects": false,
  "peerDependencies": {
    "vue": ">=3.4.0",
    "lucide-vue-next": ">=0.400.0"
  }
}
